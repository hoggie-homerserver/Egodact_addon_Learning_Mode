{
  "manifest_version": 3,
  "name": "Egodact Addon: Learning Mode",
  "version": "0.3.2",
  "description": "Eisenhower matrix, compact mode and floating notepad for Egodact.",
  "content_scripts": [
    {
      "matches": [
        "https://app.egodact.com/*"
      ],
      "js": [
        "sdk.js",
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
